{
  "name": "openfab-builder",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:certified-presets": "node scripts/generate-synthetic-fab-certified-presets.mjs",
    "check:certified-presets": "node scripts/generate-synthetic-fab-certified-presets.mjs --check",
    "prebuild": "npm run check:certified-presets",
    "build": "tsc -b && vite build",
    "prebuild:public-bundle": "npm run check:certified-presets",
    "build:public-bundle": "tsc -b && vite build --manifest",
    "check:public-bundle": "npm run build:public-bundle && node scripts/openfab-public-bundle-audit.mjs",
    "prebuild:authoring": "npm run check:certified-presets",
    "build:authoring": "tsc -b && VITE_OPENFAB_FILE_FALLBACK=1 vite build --mode authoring",
    "prebuild:project": "npm run check:certified-presets",
    "build:project": "tsc -b && VITE_OPENFAB_FILE_FALLBACK=1 vite build --mode project",
    "prebuild:scale": "npm run check:certified-presets",
    "build:scale": "tsc -b && VITE_OPENFAB_SCALE_ACCEPTANCE=1 vite build --mode scale",
    "prebuild:3d": "npm run check:certified-presets",
    "build:3d": "tsc -b && VITE_OPENFAB_FILE_FALLBACK=1 VITE_OPENFAB_SCALE_ACCEPTANCE=1 VITE_OPENFAB_DERIVED_3D=1 vite build --mode authoring",
    "prebuild:runtime": "npm run check:certified-presets",
    "build:runtime": "tsc -b && VITE_OPENFAB_FILE_FALLBACK=1 VITE_OPENFAB_DERIVED_3D=1 VITE_OPENFAB_SIMULATION=1 vite build --mode runtime",
    "preview": "vite preview",
    "test:live-demo": "node scripts/openfab-live-demo-smoke.mjs",
    "check:live-demo": "npm run build:public-bundle && npm run test:live-demo",
    "check": "biome check src/",
    "check:fix": "biome check --write src/",
    "check:core": "tsc -p tsconfig.core.json --noEmit",
    "test": "vitest run --maxWorkers=4",
    "test:authoring": "node scripts/static-fab-authoring-acceptance.mjs",
    "check:authoring": "npm run build:authoring && npm run test:authoring",
    "test:library-recovery": "node scripts/user-blueprint-library-recovery-acceptance.mjs",
    "check:library-recovery": "npm run build:authoring && npm run test:library-recovery",
    "test:scale": "node scripts/rail-scale-acceptance.mjs",
    "check:scale": "npm run build:scale && npm run test:scale",
    "test:station-proposal-scale": "vitest run --config vitest.station-proposal-scale.config.ts --maxWorkers=1 --no-file-parallelism",
    "test:project": "node scripts/openfab-project-acceptance.mjs",
    "check:project": "npm run build:project && npm run test:project",
    "test:3d": "node scripts/static-fab-3d-acceptance.mjs",
    "check:3d": "npm run build:3d && npm run test:3d",
    "test:runtime": "node scripts/simulation-runtime-acceptance.mjs",
    "check:runtime": "npm run build:runtime && npm run test:runtime",
    "test:runtime-scale": "vitest run --config vitest.scenario-runtime-scale.config.ts --maxWorkers=1 --no-file-parallelism",
    "check:runtime-scale": "npm run test:runtime-scale",
    "check:release-identity": "node scripts/openfab-release-identity-audit.mjs",
    "check:dependency-licenses": "node scripts/openfab-production-dependency-license-audit.mjs",
    "check:fixture-provenance": "node scripts/openfab-public-fixture-provenance-audit.mjs",
    "check:public-safety": "node scripts/openfab-public-safety-audit.mjs",
    "check:public-export": "node scripts/openfab-public-export-dry-run.mjs",
    "check:public-release": "npm run check:release-identity && npm run check:dependency-licenses && npm run check:fixture-provenance && node scripts/openfab-public-safety-audit.mjs --strict-release",
    "test:watch": "vitest",
    "lint": "eslint src/tilefab src/App.tsx src/main.tsx"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "lucide-react": "^1.24.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "playwright-core": "^1.61.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.2"
  }
}
