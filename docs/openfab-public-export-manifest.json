	"manualReleaseReviews": [
		"Owner-approved open-source license",
		"Final human source-originality and synthetic-fixture provenance approval",
		"Final human dependency-license and third-party-notice approval",
		"Clean history-independent export review",
		"Live demo built from the exact exported commit"
