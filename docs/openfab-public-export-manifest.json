		"NOTICE",
		"SECURITY.md",
		"CONTRIBUTING.md",
		"CHANGELOG.md",
		".github/workflows/ci.yml"
	],
	"excludedPrivatePrefixes": [
		".claude/",
		".githooks/",
		"artifacts/",
		"dist/",
		"logs/",
